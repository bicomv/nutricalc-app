{
  "name": "nutricalc",
  "version": "4.2.0",
  "description": "Nutricalc — Formulação de Dietas na Nutrição Animal",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "node scripts/setup-sqlite.js && node ./node_modules/electron-builder/out/cli/cli.js --win",
    "dist:linux": "npm run setup-sqlite:linux && electron-builder --linux",
    "setup-sqlite:win": "node scripts/setup-sqlite.js",
    "setup-sqlite:linux": "cd node_modules/better-sqlite3 && npx prebuild-install --runtime electron --target 41.2.1 --arch x64 --platform linux --force"
  },
  "author": "José Carlos Arevalo Júnior",
  "repository": "bicomv/nutricalc-app",
  "build": {
    "publish": [
      "github"
    ],
    "npmRebuild": false,
    "appId": "br.nutricalc",
    "productName": "Nutricalc",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": false
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^41.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "electron-updater": "^6.8.3",
    "pdf-parse": "^1.1.1"
  }
}
